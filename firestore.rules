rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Needs Collection
    match /needs/{needId} {
      // Anyone authenticated can read needs
      allow read: if isAuthenticated();
      // Only authenticated users can create needs, or the server via service account
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false; // Only allow soft deletes or via admin console
    }

    // Volunteers Collection
    match /volunteers/{volunteerId} {
      // Anyone authenticated can read volunteers
      allow read: if isAuthenticated();
      // Only the volunteer themselves or an admin can update their profile
      allow write: if isAuthenticated() && request.auth.uid == volunteerId;
    }

    // Assignments Collection
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Optional: Organization specific data
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only admins via backend
    }
  }
}
